# Copy to .env.local and fill in values

# Anthropic API key — powers the Claude Opus chat + AI summaries (server-side only).
# Get one at https://console.anthropic.com/. Keep this out of version control.
ANTHROPIC_API_KEY=

# DeepSeek API key (optional — only if the deepseek-chat model is used)
DEEPSEEK_API_KEY=
