# Copy to .env.local and fill in values

# Backend API base URL
NEXT_PUBLIC_API_URL=https://api-v2.genohub.org/api/v1

# Server-side API key for SSE proxy (get from Settings page after login)
FAVOR_API_KEY=

# Anthropic API key — powers the Claude Opus FAVOR-agent (server-side only).
# Get one at https://console.anthropic.com/. Keep this out of version control.
ANTHROPIC_API_KEY=

# Google Analytics (optional)
GA_TRACKING_ID=
